{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1200px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "navy", "name": "Dunkelblau", "color": "#101C2C" },
        { "slug": "anthracite", "name": "Anthrazit", "color": "#171A1F" },
        { "slug": "gold", "name": "Champagnergold", "color": "#B99A5B" },
        { "slug": "cream", "name": "Creme", "color": "#F6F3EC" },
        { "slug": "white", "name": "Weiß", "color": "#FFFFFF" },
        { "slug": "text", "name": "Fließtext", "color": "#292D33" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [{ "slug": "sans", "name": "System Sans", "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif" }],
      "fontSizes": [
        { "slug": "small", "name": "Klein", "size": "0.875rem" },
        { "slug": "medium", "name": "Text", "size": "1.0625rem" },
        { "slug": "large", "name": "Abschnitt", "size": "2rem" },
        { "slug": "x-large", "name": "Titel", "size": "3.75rem" }
      ]
    },
    "spacing": { "units": ["px", "rem", "%", "vw"], "blockGap": true }
  },
  "styles": {
    "color": { "background": "var:preset|color|cream", "text": "var:preset|color|text" },
    "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.65" },
    "elements": {
      "heading": { "color": { "text": "var:preset|color|navy" }, "typography": { "fontWeight": "650", "lineHeight": "1.12", "letterSpacing": "-0.035em" } },
      "button": { "color": { "background": "var:preset|color|gold", "text": "var:preset|color|navy" }, "border": { "radius": "6px" }, "typography": { "fontWeight": "650" }, "spacing": { "padding": { "top": "14px", "right": "24px", "bottom": "14px", "left": "24px" } } },
      "link": { "color": { "text": "var:preset|color|navy" } }
    }
  }
}
