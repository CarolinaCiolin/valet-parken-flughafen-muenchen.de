{
  "apiVersion": 3,
  "name": "vpm-booking/form",
  "title": "VPM Buchungsanfrage",
  "category": "widgets",
  "icon": "airplane",
  "description": "Dynamischer Baustein des VPM Buchungskerns.",
  "attributes": {
    "airport": {
      "type": "string",
      "default": ""
    },
    "locale": {
      "type": "string",
      "default": "auto"
    },
    "airport_mode": {
      "type": "string",
      "default": ""
    },
    "flow": {
      "type": "string",
      "default": "inline"
    },
    "service": {
      "type": "string",
      "default": "any"
    },
    "time_basis": {
      "type": "string",
      "default": "flight"
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "editorScript": "vpm-booking-block-editor",
  "style": "vpm-booking-front"
}
